# Gitignore settings for ESPHome
# This is an example and may include too much for your use-case.
# You can modify this file to suit your needs.
/.esphome/
/secrets.yaml

# FreeCAD documents are regenerated by the tools/cad scripts; the .py, .stl and .step are the versioned artefacts
*.FCStd
*.FCStd1
*.FCBak
__pycache__/
